<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <!-- Zero warnings today; keep it that way. Style/analyzer rules are not yet enforced
         in the build (EnforceCodeStyleInBuild is off) so only compiler/analyzer warnings count. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
